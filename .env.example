# Порт бекенду (у dev-режимі Vite працює на 5173 і проксіює /api на 3456)
PORT=3456

# Базова адреса сервера (використовується для формування Google OAuth Redirect URI)
# Наприклад, локально: http://localhost:3456
# На VPS з доменом: https://autopost.yourdomain.com
PUBLIC_BASE_URL=http://localhost:3456

# URL фронтенду для редіректу після OAuth у dev-режимі (необов'язково, якщо продакшн)
FRONTEND_URL=http://localhost:5173

# Google Cloud OAuth 2.0 (можна залишити порожнім і ввести прямо в інтерфейсі сайту -> Налаштування)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключ шифрування токенів (32+ символи). Якщо порожній — автоматично згенерується у data/.secret.key
APP_ENCRYPTION_KEY=

# Необов'язковий пароль для входу в веб-панель (корисно при запуску на VPS)
ADMIN_PASSWORD=
